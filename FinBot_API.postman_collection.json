    {
      "name": "4. Transactions",
      "item": [
        {
          "name": "Create Transaction",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var data = pm.response.json();",
                  "if (data && data.id) {",
                  "    pm.collectionVariables.set(\"transactionId\", data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bankAccountId\": \"{{accountId}}\",\n  \"amount\": 50.00,\n  \"type\": \"DEBIT\",\n  \"category\": \"Groceries\",\n  \"description\": \"Walmart Shopping\",\n  \"transactionDate\": \"2024-05-15T14:30:00\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transactions"]
            }
          }
        },
        {
          "name": "Get All User Transactions",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/transactions?page=0&size=20&sort=transactionDate,desc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transactions"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" },
                { "key": "sort", "value": "transactionDate,desc" }
              ]
            }
          }
        },
        {
          "name": "Get Transactions by Account",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/transactions/account/{{accountId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transactions", "account", "{{accountId}}"]
            }
          }
        },
        {
          "name": "Get Transactions by Date Range",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/transactions/daterange?startDate=2024-05-01T00:00:00&endDate=2024-05-31T23:59:59",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transactions", "daterange"],
              "query": [
                { "key": "startDate", "value": "2024-05-01T00:00:00" },
                { "key": "endDate", "value": "2024-05-31T23:59:59" }
              ]
            }
          }
        },
        {
          "name": "Get Transactions by Category",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/transactions/category/Groceries",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transactions", "category", "Groceries"]
            }
          }
        },
        {
          "name": "Get Transaction By ID",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "GET",
            "url": {
